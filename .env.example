# Copy to .env (which git ignores) and fill in. Absolute paths.

# Holds autotranscode.toml. Start from config.example.toml, and use container
# paths in it: /data for anything under the work directory, the library path as is.
CONFIG_DIR=
# Work directory, state file, staging, logs and sample runs. Plenty of room, on a
# fast disk: a 4K film is staged here, and its chunks are written here.
DATA_DIR=
# The library, mounted at the same path inside the container.
LIBRARY=

# Your time zone, for log times: `timedatectl show -p Timezone --value` on Linux,
# `readlink /etc/localtime` on a Mac (the part after zoneinfo/). Europe/Berlin, say.
TZ=

# Linux: your ids (`id -u`, `id -g`), so that files come out owned by you.
UID=1000
GID=1000

# With compose.rk3588.yaml or compose.vaapi.yaml: the host's group ids
# (`getent group video render`).
VIDEO_GID=44
RENDER_GID=991
